{
  "info": {
    "_postman_id": "eig-collection-v1",
    "name": "Enterprise Integration Gateway",
    "description": "Complete API test collection for the Enterprise Integration Gateway.\n\nWorkflows:\n1. Happy Path: Health → CRM Sync → View Customers → View Orders\n2. Vendor Sync: Vendor Sync → View Shipments → Check Failed Records\n3. Full Sync: Sync All → Admin Status\n4. Failure & Retry: View Failed Records → Retry Record",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & Metrics",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is healthy', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql('healthy');",
                  "});",
                  "pm.test('DB check present', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.checks).to.have.property('database');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/health",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Returns application health including database connectivity."
          }
        },
        {
          "name": "Metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has customer count', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('eig_customers_total');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/metrics",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "metrics"]
            },
            "description": "Lightweight metrics: total record counts."
          }
        },
        {
          "name": "Admin Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has record counts', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('record_counts');",
                  "    pm.expect(body).to.have.property('failed_records');",
                  "    pm.expect(body).to.have.property('recent_sync_jobs');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/admin/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "status"]
            },
            "description": "Operational dashboard: counts, recent jobs, failed records, scheduler state."
          }
        }
      ]
    },
    {
      "name": "Sync Triggers",
      "item": [
        {
          "name": "Trigger CRM Sync",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has job_id', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('job_id');",
                  "    pm.environment.set('last_job_id', body.job_id);",
                  "});",
                  "pm.test('Job type is crm_sync', () => {",
                  "    pm.expect(pm.response.json().job_type).to.eql('crm_sync');",
                  "});",
                  "pm.test('Has correlation_id', () => {",
                  "    pm.expect(pm.response.json()).to.have.property('correlation_id');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/sync/crm",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sync", "crm"]
            },
            "description": "Triggers a CRM JSON sync. Fetches customers and orders, transforms, and upserts."
          }
        },
        {
          "name": "Trigger Vendor Sync",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Job type is vendor_sync', () => {",
                  "    pm.expect(pm.response.json().job_type).to.eql('vendor_sync');",
                  "});",
                  "pm.test('Records failed ≥ 1 (malformed XML record)', () => {",
                  "    pm.expect(pm.response.json().records_failed).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/sync/vendor",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sync", "vendor"]
            },
            "description": "Triggers a Vendor XML sync. Includes one malformed record — expect records_failed >= 1."
          }
        },
        {
          "name": "Trigger Full Sync (CRM + Vendor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Job type is full_sync', () => {",
                  "    pm.expect(pm.response.json().job_type).to.eql('full_sync');",
                  "});",
                  "pm.test('Records processed > 0', () => {",
                  "    pm.expect(pm.response.json().records_processed).to.be.greaterThan(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/sync/all",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sync", "all"]
            },
            "description": "Triggers both CRM and Vendor syncs sequentially. Returns aggregated result."
          }
        }
      ]
    },
