    {
      "name": "Failed Records",
      "item": [
        {
          "name": "List All Failed Records",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.length > 0) {",
                  "    pm.environment.set('last_failed_record_id', body[0].id);",
                  "    console.log('Set last_failed_record_id to', body[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/failed-records",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "failed-records"]
            }
          }
        },
        {
          "name": "List Failed Records (vendor source)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/failed-records?source=vendor",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "failed-records"],
              "query": [{"key": "source", "value": "vendor"}]
            }
          }
        },
        {
          "name": "Retry Failed Record",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 404 or 409', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404, 409]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Has status field', () => {",
                  "        pm.expect(pm.response.json()).to.have.property('status');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/failed-records/{{last_failed_record_id}}/retry",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "failed-records", "{{last_failed_record_id}}", "retry"]
            },
            "description": "Retry a failed record. Runs the original raw payload through transformation again."
          }
        }
      ]
    },
