# ── Application ─────────────────────────────────────────────────────────────────
APP_NAME="Enterprise Integration Gateway"
APP_VERSION="2.0.0"
APP_ENV=development
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://eig_user:eig_password@localhost:5432/eig_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Mock Provider URLs ────────────────────────────────────────────────────────────
# In Docker Compose these point to the mock_providers service; locally use localhost
CRM_BASE_URL=http://localhost:8001
VENDOR_BASE_URL=http://localhost:8001

# ── HTTP Client ───────────────────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_FACTOR=0.5

# ── Background Scheduler ─────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
CRM_SYNC_INTERVAL_MINUTES=15
VENDOR_SYNC_INTERVAL_MINUTES=15

# ── Failure Handling ─────────────────────────────────────────────────────────────
MAX_RETRY_COUNT=3

# ── Logging ───────────────────────────────────────────────────────────────────────
# LOG_FORMAT: "json" (structured) or "text" (human-readable)
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── CORS ─────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
ALLOWED_ORIGINS=*

# ── Redis ────────────────────────────────────────────────────────────────────────
# Used for response caching and API rate limiting
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
CACHE_TTL_SECONDS=60
RATE_LIMIT_RPM=30

# ── Kafka ────────────────────────────────────────────────────────────────────────
# Used for async event publishing and inbound sync request consumption
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENTS_TOPIC=eig.integration.events
KAFKA_INBOUND_TOPIC=eig.inbound.sync.requests
KAFKA_CONSUMER_GROUP=eig-gateway-group
