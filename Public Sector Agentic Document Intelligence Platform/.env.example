# =============================================================================
# PublicSector Agentic Document Intelligence Platform — example environment
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# Runtime
ENV=development
LOG_LEVEL=INFO
SEED_ON_BOOT=true

# Public URLs (used by frontend; reflected back in CORS)
ALLOWED_ORIGINS=http://localhost:5173

# --- Database -----------------------------------------------------------------
POSTGRES_USER=psdi
POSTGRES_PASSWORD=psdi_dev_password
POSTGRES_DB=psdi
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://psdi:psdi_dev_password@postgres:5432/psdi
DATABASE_URL_SYNC=postgresql+psycopg://psdi:psdi_dev_password@postgres:5432/psdi

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MLflow -------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=psdi

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- JWT ----------------------------------------------------------------------
# HS256 fallback used unless JWT_PRIVATE_KEY_PATH is set.
JWT_SECRET=please-change-me-to-a-long-random-string-in-production
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=psdi

# --- Storage ------------------------------------------------------------------
STORAGE_BACKEND=local   # local | s3
LOCAL_UPLOAD_DIR=/data/uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Reranker -----------------------------------------------------------------
RERANKER_BACKEND=local   # local | sagemaker
SAGEMAKER_RERANKER_ENDPOINT=
SAGEMAKER_ROLE_ARN=
AWS_REGION=us-east-1

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_QUERY_PER_MIN=30
RATE_LIMIT_UPLOAD_PER_HOUR=10

# --- Seeded demo credentials (development only) -------------------------------
SEED_ORG_NAME=Demo Agency
SEED_ORG_SLUG=demo-agency
SEED_ADMIN_EMAIL=seed-admin@example.gov
SEED_ADMIN_PASSWORD=ChangeMe!2026
